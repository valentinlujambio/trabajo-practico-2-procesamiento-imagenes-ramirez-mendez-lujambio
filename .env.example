# Origenes autorizados para CORS. Acepta lista separada por comas o JSON:
#   CORS_ORIGINS=https://mi-portfolio.com,http://localhost:3000
#   CORS_ORIGINS=["https://mi-portfolio.com","http://localhost:3000"]
# Sin barra final: el navegador manda el header Origin sin barra.
CORS_ORIGINS=https://portfolio-personal-production-278c.up.railway.app,http://localhost:3000

# Puerto del microservicio (Railway lo inyecta solo).
PORT=8001

# Tamaño de las imagenes que devuelve el paso a paso.
MAX_WIDTH=760
JPEG_QUALITY=78
